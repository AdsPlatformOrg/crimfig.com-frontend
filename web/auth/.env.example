# ─────────────────────────────────────────────────────────────────────────────
# CrimFig Auth Web Client — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# Leave empty in local development to use the Next.js /api rewrite proxy
NEXT_PUBLIC_API_URL=

# Auth Web Client URL
NEXT_PUBLIC_AUTH_WEB_URL=http://localhost:3000

# Application Branding
NEXT_PUBLIC_APP_NAME=CrimFig Identity

# Ecosystem Application URLs
NEXT_PUBLIC_ADS_URL=http://localhost:3001
NEXT_PUBLIC_CHAT_URL=http://localhost:3002
NEXT_PUBLIC_REELS_URL=http://localhost:3005
NEXT_PUBLIC_STREAM_URL=http://localhost:3006
NEXT_PUBLIC_TETRIS_URL=http://localhost:3007
