{
  "name": "crimfig-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "CrimFig Frontend — Next.js web apps and React Native mobile apps for all ecosystem subdomains",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "pnpm": ">=9.0.0",
    "npm": "PLEASE_USE_PNPM_INSTEAD",
    "yarn": "PLEASE_USE_PNPM_INSTEAD"
  },
  "scripts": {
    "api:generate": "node shared/api-client/scripts/contracts.mjs generate",
    "api:check": "node shared/api-client/scripts/contracts.mjs check",
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "eslint-config-next": "15.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
